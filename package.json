{
  "name": "life-dashboard",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @life/db generate",
    "db:migrate": "pnpm --filter @life/db migrate",
    "db:copy-to-neon": "node --env-file=.env scripts/db-copy-to-neon.mjs",
    "backfill:portfolio": "pnpm --filter @life/api exec tsx scripts/backfill-portfolio-value.ts",
    "backfill:401k": "pnpm --filter @life/api exec tsx scripts/backfill-401k.ts"
  }
}
