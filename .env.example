# Postgres. Shared across machines via Neon (free tier) so the PC and the
# laptop read/write the same data. Copy the *direct* (non-pooled) connection
# string from the Neon dashboard - drizzle-kit migrate needs a real session,
# which the -pooler endpoint (PgBouncer, transaction mode) does not give you.
# postgres-js reads sslmode straight off the URL; verify-full checks the cert,
# fall back to `require` if the TLS handshake ever fails.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/life?sslmode=verify-full

# Local docker Postgres (docker-compose.yml) - kept as an offline fallback.
# DATABASE_URL=postgres://life:life@localhost:5432/life

# Only needed for the one-time `pnpm db:copy-to-neon` migration, where
# DATABASE_URL is still the local docker Postgres and this is the destination.
# NEON_DATABASE_URL=

# Single-user auth for /api/* — generate with: openssl rand -hex 24
API_TOKEN=change-me-generate-a-real-one
# Same value, exposed to the web app by Vite
VITE_API_TOKEN=change-me-generate-a-real-one

# API port
PORT=3001

# Obsidian vault (Phase 4 — VaultStore), e.g. the iCloud path:
# /Users/<you>/Library/Mobile Documents/iCloud~md~obsidian/Documents/<vault>
VAULT_PATH=

# Phase 1: Todoist — Settings → Integrations → Developer
# TODOIST_API_TOKEN=

# Finance: Finnhub live stock quotes — free key at https://finnhub.io/register
FINNHUB_API_KEY=

# Calendar: iCloud CalDAV (read-only). Apple ID email + app-specific password
# generated at account.apple.com -> Sign-In and Security -> App-Specific Passwords
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Weather (Home widget): Open-Meteo, free/no key. A city name is geocoded
# server-side; or set explicit WEATHER_LATITUDE/WEATHER_LONGITUDE to skip that.
WEATHER_LOCATION=Boston, MA

# Bank spending: Plaid (dashboard.plaid.com -> Developers -> Keys). Use the
# secret matching PLAID_ENV. After setting the first two, visit /plaid-link in
# the web app to connect a bank; paste the resulting access token below.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_ACCESS_TOKEN=
# Second Plaid item for the Stocks page's NM tab (investments product, holdings
# only). Link at /plaid-link?mode=investments; paste the access token here.
PLAID_NM_ACCESS_TOKEN=
