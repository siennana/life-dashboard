# ============================================================================
# Life Dashboard .env - the shared contract. Copy to .env and fill in.
# The real .env is never committed; its canonical copy lives in a private
# secure note. A missing var disables that feature on this machine (the
# connector is silently skipped), nothing crashes.
# ============================================================================

# ---- Database --------------------------------------------------------------
# Shared across machines via Neon (free tier) so the PC and the laptop
# read/write the same data. Copy the *direct* (non-pooled) connection string
# from the Neon dashboard - drizzle-kit migrate needs a real session, which
# the -pooler endpoint (PgBouncer, transaction mode) does not give you.
# postgres-js reads sslmode straight off the URL; verify-full checks the cert,
# fall back to `require` if the TLS handshake ever fails.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/life?sslmode=verify-full
# Local docker Postgres (docker-compose.yml) - kept as an offline fallback.
# DATABASE_URL=postgres://life:life@localhost:5432/life
# Only needed for the one-time `pnpm db:copy-to-neon` migration, where
# DATABASE_URL is still the local docker Postgres and this is the destination.
# NEON_DATABASE_URL=

# ---- App -------------------------------------------------------------------
# Single-user auth for /api/* - generate with: openssl rand -hex 24.
# VITE_API_TOKEN is the same value, exposed to the web app by Vite.
API_TOKEN=change-me-generate-a-real-one
VITE_API_TOKEN=change-me-generate-a-real-one
PORT=3001

# Obsidian vault (Phase 4 - VaultStore), e.g. the iCloud path:
# /Users/<you>/Library/Mobile Documents/iCloud~md~obsidian/Documents/<vault>
VAULT_PATH=

# ---- Todos: Todoist (Settings -> Integrations -> Developer) ----------------
# TODOIST_API_TOKEN=

# ---- Calendar: iCloud CalDAV (read-only) -----------------------------------
# Apple ID email + app-specific password generated at account.apple.com ->
# Sign-In and Security -> App-Specific Passwords.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# ---- Weather: Open-Meteo (Home widget; free, no key) -----------------------
# A city name is geocoded server-side; or set explicit WEATHER_LATITUDE /
# WEATHER_LONGITUDE to skip that.
WEATHER_LOCATION=Boston, MA

# ---- Finance: live stock quotes --------------------------------------------
# Finnhub free key at https://finnhub.io/register.
FINNHUB_API_KEY=

# ---- Finance: Plaid (dashboard.plaid.com -> Developers -> Keys) ------------
# One client (use the secret matching PLAID_ENV), then one access token per
# linked institution ("item"). Link each at the URL noted; the page prints the
# token to paste here.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# Bank item (transactions product - Bank page spending). Link at /plaid-link.
PLAID_US_BANK_ACCESS_TOKEN=
# Brokerage item (investments product - Stocks NM tab). Link at
# /plaid-link?mode=investments.
PLAID_NM_ACCESS_TOKEN=
# Brokerage item (investments product) covering every account under the
# Fidelity login: brokerage -> Individual tab, 401k subtype -> FactSet 401k
# tab. Optional - holdings sync automatically instead of via CSV upload once
# set. Link at /plaid-link?mode=investments&account=individual.
PLAID_FIDELITY_ACCESS_TOKEN=

# ---- GitHub: contribution heatmap + commit history (Home/Projects) ---------
# Classic personal access token with just the read:user scope
# (github.com -> Settings -> Developer settings).
GITHUB_TOKEN=
